# Credential policy, selected only by the host: server (default) or user.
# server: use only administrator keys below; users cannot override them.
# user: require an encrypted personal profile; never use administrator keys.
CREDENTIAL_MODE=server
# Personal mode requires persistent storage and a stable random 32-byte hex key.
# Prefer a mounted Docker secret; alternatively set PROFILE_ENCRYPTION_KEY.
# PROFILE_DIR=/data/profiles
# PROFILE_ENCRYPTION_KEY_FILE=/run/secrets/profile_encryption_key
# Trust only your actual reverse proxy addresses/CIDRs, never all clients.
# TRUST_PROXY=loopback

# Public base URL of this addon, used to build the subtitle links handed to
# Stremio. Leave it unset to use the address each client connected to. That is
# what you want for a TV or phone on your local network, and it is fine behind
# a single proxy. A 127.0.0.1 value is ignored for clients on other devices.
# BASE_URL=http://127.0.0.1:7000

PORT=7000

# --- OpenSubtitles ---
# Server mode: required unless SUBDL_API_KEY is configured. Get one at https://www.opensubtitles.com/consumers
OS_API_KEY=

# Optional. Without them you get the small anonymous download quota.
# With them, downloads count against your own account quota.
OS_USERNAME=
OS_PASSWORD=

# --- SubDL (optional, server-side only) ---
# Get a key at https://subdl.com/developers. Never put it in the install URL.
# Provides candidate subtitles, not proof of timing. Sync still needs an
# OpenSubtitles reference or a verified TorBox embedded subtitle track.
SUBDL_API_KEY=

# --- Defaults (users can override per install via the /configure page) ---
# Languages you want subtitles in, comma separated, OpenSubtitles codes.
LANGUAGES=pl,en
# Languages allowed to act as the timing anchor.
ANCHOR_LANGUAGES=en,pl
# How many subtitles to offer per language.
MAX_PER_LANG=5
# Offer subtitles that could not be aligned to anything. Off by default:
# other addons already serve subtitles as uploaded, so an entry this addon
# cannot improve is only noise in the player's menu.
INCLUDE_UNSYNCED=
# How subtitles are labelled in the player.
#   iso     - plain codes (pol, eng). Stremio lists them under its own
#             "Polski" / "English" entries, next to other addons. Default.
#   verbose - "Polish - auto-synced" and so on. Shows the timing method, but
#             each label becomes a separate entry in the menu.
LABELS=iso

# --- Reading timings from the video itself (optional) ---
# Fallback for when OpenSubtitles has never seen your file. The addon finds the
# file again on your TorBox account, confirms it byte for byte with the same
# hash Stremio sent, and reads the timing of its built-in subtitle track: from
# the file's seek index when it has one (MKV, under 1 MB), otherwise from a few
# short sampled stretches.
#
# Leave TORBOX_API_KEY empty to switch the whole feature off.
TORBOX_API_KEY=

# How many stretches of the file to sample, and how long each one is.
# Traffic is roughly windows x seconds x the file's bitrate, so the defaults
# below read 120 seconds: about 30 MB of a 2 Mbps film, about 330 MB of a
# 22 Mbps remux. Paid once per file, then cached.
EMBEDDED_WINDOWS=6
EMBEDDED_WINDOW_SECONDS=20

# Path to ffprobe, if it is not on PATH.
FFPROBE_PATH=

LOG_LEVEL=info
# Every log line also goes to this file. Set to "off" to write no file.
LOG_FILE=subtitle-sync.log

# --- Optional AI translation (off until explicitly enabled) ---
# Server mode uses these credentials. Personal mode uses encrypted profile
# fields instead and never falls back to the administrator's AI account.
AI_ENABLED=false
# API base only; /chat/completions is appended. Keep keys out of the URL.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Optional JSON headers, e.g. '{"X-Title":"Subtitle Sync"}'.
AI_HEADERS=
AI_SOURCE_LANGUAGES=en
# Use only capabilities supported by the selected model/gateway.
AI_TOKEN_PARAMETER=max_tokens
AI_JSON_MODE=off
AI_MAX_OUTPUT_TOKENS=4096
# Personal mode: exact comma-separated base URLs permitted by the host.
AI_ALLOWED_BASE_URLS=
# Explicit permission for trusted private HTTP gateways/local inference only.
AI_ALLOW_HTTP=false
# Global bounds; profile users cannot raise these limits.
AI_BATCH_CUES=32
AI_BATCH_CHARACTERS=6000
AI_MAX_CUES=5000
AI_MAX_CHARACTERS=500000
AI_REQUEST_TIMEOUT_MS=30000
AI_JOB_TIMEOUT_MS=180000
AI_RESPONSE_WAIT_MS=5000
AI_HOURLY_CALLS=120
AI_CONCURRENCY=2

# --- Persistent translation library (opt-in, dedicated persistent volume) ---
# Mount this directory outside the container's disposable filesystem.
# TRANSLATION_LIBRARY_DIR=/data/translations
TRANSLATION_LIBRARY_MAX_BYTES=1073741824
TRANSLATION_LIBRARY_MAX_ITEMS=10000
# Personal profiles are private by default. Explicitly permit instance-wide
# reuse only when source/content rights and intended user access allow it.
# Personal profiles also require explicit consent in the setup form.
TRANSLATION_LIBRARY_SHARED=false
# Bump this when opaque gateway routing, header semantics or model aliases change.
AI_PROFILE_REVISION=1

# --- Reviewed SubDL publication (operator CLI only; no automatic uploads) ---
SUBDL_PUBLISHING_ENABLED=false
# Separate upload-authentication token, not the search/download API key.
# Keep secret files outside the translation-library volume.
# SUBDL_UPLOAD_TOKEN_FILE=/run/secrets/subdl_upload_token
# SUBDL_UPLOAD_TOKEN=
# Required before enabling: raw or bearer-final, verified for your account.
# SUBDL_UPLOAD_HEADER_MODE=
